# `mise run setup` copies this file to .env (gitignored) and fills in a random
# local POSTGRES_PASSWORD. Never put a production credential in .env; Beny Bot Dev's values
# are the one exception, since it also serves the live site for now (docs/cutover.md Part 4).

# Local Postgres from compose.yaml, bound to 127.0.0.1:54329.
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
DATABASE_URL=postgres://colony:__POSTGRES_PASSWORD__@127.0.0.1:54329/colony?sslmode=disable
TEST_DATABASE_URL=postgres://colony:__POSTGRES_PASSWORD__@127.0.0.1:54329/colony_test?sslmode=disable

# The address the browser uses. Locally that is the Vite dev server.
PUBLIC_URL=http://localhost:5173
# development | test | production
APP_ENV=development
# Optional: uncomment to move the Go server off 8080 (Vite's proxy expects 8080).
# PORT=8080

# Discord: Beny Bot Dev's values only (docs/discord-dev-setup.md). Leave them empty
# to keep Beny Bot off and use dev sign-in. While Railway has Beny Bot Dev's token,
# DISCORD_BOT_TOKEN stays blank here: one token, one running Beny Bot.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# The site owner: approves campaigns on /admin. Your own Discord user ID; empty in dev means the
# seeded Sample DM (seed:dm). It confers nothing inside a campaign.
SITE_OWNER_DISCORD_ID=

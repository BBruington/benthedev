{
  "components": {
    "schemas": {
      "CharacterNameInput": {
        "additionalProperties": false,
        "properties": {
          "characterName": {
            "maxLength": 60,
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "characterName"
        ],
        "type": "object"
      },
      "DevSignInMember": {
        "additionalProperties": false,
        "properties": {
          "characterName": {
            "type": [
              "string",
              "null"
            ]
          },
          "displayName": {
            "type": "string"
          },
          "isDm": {
            "type": "boolean"
          },
          "memberId": {
            "format": "uuid",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/MemberStatus"
          }
        },
        "required": [
          "memberId",
          "displayName",
          "characterName",
          "status",
          "isDm"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": "array"
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "InvalidateMessage": {
        "additionalProperties": false,
        "properties": {
          "topics": {
            "items": {
              "$ref": "#/components/schemas/Topic"
            },
            "type": "array"
          }
        },
        "required": [
          "topics"
        ],
        "type": "object"
      },
      "LoginOptions": {
        "additionalProperties": false,
        "properties": {
          "devSignIn": {
            "description": "Present only in devauth builds",
            "items": {
              "$ref": "#/components/schemas/DevSignInMember"
            },
            "type": "array"
          },
          "discordEnabled": {
            "type": "boolean"
          }
        },
        "required": [
          "discordEnabled"
        ],
        "type": "object"
      },
      "Me": {
        "additionalProperties": false,
        "properties": {
          "isDm": {
            "type": "boolean"
          },
          "member": {
            "$ref": "#/components/schemas/Member"
          },
          "status": {
            "$ref": "#/components/schemas/MemberStatus"
          },
          "viewAsPlayer": {
            "type": "boolean"
          }
        },
        "required": [
          "member",
          "status",
          "isDm",
          "viewAsPlayer"
        ],
        "type": "object"
      },
      "Member": {
        "additionalProperties": false,
        "properties": {
          "avatarUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "characterName": {
            "type": [
              "string",
              "null"
            ]
          },
          "displayName": {
            "type": "string"
          },
          "dm": {
            "$ref": "#/components/schemas/MemberDm"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "id",
          "displayName",
          "avatarUrl",
          "characterName"
        ],
        "type": "object"
      },
      "MemberDm": {
        "additionalProperties": false,
        "properties": {
          "approvedAt": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "discordUserId": {
            "type": "string"
          },
          "discordUsername": {
            "type": "string"
          },
          "isDm": {
            "type": "boolean"
          },
          "lastSeenAt": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/MemberStatus"
          }
        },
        "required": [
          "discordUserId",
          "discordUsername",
          "status",
          "isDm",
          "createdAt",
          "approvedAt",
          "lastSeenAt"
        ],
        "type": "object"
      },
      "MemberGroups": {
        "additionalProperties": false,
        "properties": {
          "active": {
            "items": {
              "$ref": "#/components/schemas/Member"
            },
            "type": "array"
          },
          "pending": {
            "items": {
              "$ref": "#/components/schemas/Member"
            },
            "type": "array"
          },
          "removed": {
            "items": {
              "$ref": "#/components/schemas/Member"
            },
            "type": "array"
          }
        },
        "required": [
          "pending",
          "active",
          "removed"
        ],
        "type": "object"
      },
      "MemberStatus": {
        "enum": [
          "PENDING",
          "ACTIVE",
          "REMOVED"
        ],
        "type": "string"
      },
      "ProfileInput": {
        "additionalProperties": false,
        "properties": {
          "characterName": {
            "maxLength": 60,
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "characterName"
        ],
        "type": "object"
      },
      "Settings": {
        "additionalProperties": false,
        "properties": {
          "botInviteUrl": {
            "description": "Adds Beny Bot to a Discord server; null until DISCORD_CLIENT_ID is set",
            "type": [
              "string",
              "null"
            ]
          },
          "campaignName": {
            "type": "string"
          },
          "discordAnnounceChannelId": {
            "type": [
              "string",
              "null"
            ]
          },
          "discordDmChannelId": {
            "type": [
              "string",
              "null"
            ]
          },
          "discordReminderChannelId": {
            "type": [
              "string",
              "null"
            ]
          },
          "timezone": {
            "description": "IANA time zone, e.g. America/New_York",
            "type": "string"
          }
        },
        "required": [
          "campaignName",
          "timezone",
          "discordAnnounceChannelId",
          "discordReminderChannelId",
          "discordDmChannelId",
          "botInviteUrl"
        ],
        "type": "object"
      },
      "SettingsInput": {
        "additionalProperties": false,
        "properties": {
          "campaignName": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "discordAnnounceChannelId": {
            "pattern": "^[0-9]{17,20}$",
            "type": [
              "string",
              "null"
            ]
          },
          "discordDmChannelId": {
            "pattern": "^[0-9]{17,20}$",
            "type": [
              "string",
              "null"
            ]
          },
          "discordReminderChannelId": {
            "pattern": "^[0-9]{17,20}$",
            "type": [
              "string",
              "null"
            ]
          },
          "timezone": {
            "description": "IANA time zone, e.g. America/New_York",
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "campaignName",
          "timezone",
          "discordAnnounceChannelId",
          "discordReminderChannelId",
          "discordDmChannelId"
        ],
        "type": "object"
      },
      "Topic": {
        "enum": [
          "me",
          "members",
          "settings"
        ],
        "type": "string"
      },
      "ViewAsPlayerInput": {
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "enabled"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Colony Planner",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/login-options": {
      "get": {
        "operationId": "getLoginOptions",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginOptions"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Sign-in methods for /login",
        "tags": [
          "auth"
        ],
        "x-access": "public"
      }
    },
    "/api/me": {
      "get": {
        "operationId": "getMe",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "The signed-in member, their status and whether they are the DM",
        "tags": [
          "me"
        ],
        "x-access": "pending"
      }
    },
    "/api/me/profile": {
      "put": {
        "operationId": "updateProfile",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Replace the caller's profile (character name)",
        "tags": [
          "me"
        ],
        "x-access": "member"
      }
    },
    "/api/me/view-as-player": {
      "post": {
        "operationId": "setViewAsPlayer",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ViewAsPlayerInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Turn view as player on or off (DM only); then read /api/me again",
        "tags": [
          "me"
        ],
        "x-access": "member"
      }
    },
    "/api/members": {
      "get": {
        "operationId": "listMembers",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberGroups"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Pending, active and removed members",
        "tags": [
          "members"
        ],
        "x-access": "dm"
      }
    },
    "/api/members/{memberId}/approve": {
      "post": {
        "operationId": "approveMember",
        "parameters": [
          {
            "in": "path",
            "name": "memberId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Member"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Let a pending member in",
        "tags": [
          "members"
        ],
        "x-access": "dm"
      }
    },
    "/api/members/{memberId}/character-name": {
      "put": {
        "operationId": "setMemberCharacterName",
        "parameters": [
          {
            "in": "path",
            "name": "memberId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CharacterNameInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Member"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Set a member's character name",
        "tags": [
          "members"
        ],
        "x-access": "dm"
      }
    },
    "/api/members/{memberId}/deny": {
      "post": {
        "operationId": "denyMember",
        "parameters": [
          {
            "in": "path",
            "name": "memberId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Member"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Turn a pending member away",
        "tags": [
          "members"
        ],
        "x-access": "dm"
      }
    },
    "/api/members/{memberId}/readmit": {
      "post": {
        "operationId": "readmitMember",
        "parameters": [
          {
            "in": "path",
            "name": "memberId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Member"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Let a removed or denied member back in",
        "tags": [
          "members"
        ],
        "x-access": "dm"
      }
    },
    "/api/members/{memberId}/remove": {
      "post": {
        "operationId": "removeMember",
        "parameters": [
          {
            "in": "path",
            "name": "memberId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Member"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Remove an active member and sign them out everywhere",
        "tags": [
          "members"
        ],
        "x-access": "dm"
      }
    },
    "/api/settings": {
      "get": {
        "operationId": "getSettings",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Campaign settings",
        "tags": [
          "settings"
        ],
        "x-access": "dm"
      },
      "put": {
        "operationId": "updateSettings",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettingsInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Replace the campaign settings",
        "tags": [
          "settings"
        ],
        "x-access": "dm"
      }
    }
  },
  "x-stream-events": {
    "invalidate": {
      "$ref": "#/components/schemas/InvalidateMessage"
    }
  }
}
